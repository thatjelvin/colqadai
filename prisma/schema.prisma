generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  clerkUserId   String?   @unique
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  passwordHash  String? // null for OAuth users
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  grade                        String?
  course                       String?
  age                          Int?
  source                       String?
  plan                         Plan               @default(FREE)
  subscriptionStatus           SubscriptionStatus @default(INACTIVE)
  subscriptionCurrentPeriodEnd DateTime?
  paddleCustomerId             String?
  paddleSubscriptionId         String?
  paddlePriceId                String?
  tier                         Tier               @default(FREE)
  referralCode                 String?            @unique
  referralPromptedAt           DateTime?
  proUntil                     DateTime?
  referredById                 String?
  referredBy                   User?              @relation("Referral", fields: [referredById], references: [id])
  referrals                    User[]             @relation("Referral")

  accounts              Account[]
  sessions              Session[]
  userProblems          UserProblem[]
  attempts              ProblemAttempt[]
  reflections           Reflection[]
  workedExampleSessions WorkedExampleSession[]
  learningAnalytics     LearningAnalytics[]
  chatSessions          ChatSession[]
  usageEvents           UsageEvent[]
  notebooks             Notebook[]
  notebookDocuments     NotebookDocument[]
  notebookChunks        NotebookChunk[]
  notebookSummaries     NotebookSummary[]
  notebookConcepts      NotebookConcept[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  parent   Topic?    @relation("TopicHierarchy", fields: [parentId], references: [id])
  children Topic[]   @relation("TopicHierarchy")
  problems Problem[]
}

model Problem {
  id         String     @id @default(cuid())
  topicId    String
  title      String
  body       String // LaTeX problem statement
  solution   String // LaTeX solution
  topicTag   String?    @map("topic_tag")
  difficulty Difficulty
  createdAt  DateTime   @default(now())

  topic                 Topic                  @relation(fields: [topicId], references: [id])
  userProblems          UserProblem[]
  attempts              ProblemAttempt[]
  reflections           Reflection[]
  workedExampleSessions WorkedExampleSession[]
  chatSessions          ChatSession[]
}

model UserProblem {
  id                    String       @id @default(cuid())
  userId                String
  problemId             String
  easeFactor            Float        @default(2.5)
  interval              Int          @default(1) // days until next review
  repetitions           Int          @default(0) // consecutive successful reviews
  nextReviewAt          DateTime
  lastReviewedAt        DateTime?
  timeTaken             Int? // time taken in seconds
  attemptsBeforeCorrect Int          @default(0) @map("attempts_before_correct")
  status                ReviewStatus @default(NEW)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem               Problem                @relation(fields: [problemId], references: [id], onDelete: Cascade)
  attempts              ProblemAttempt[]
  workedExampleSessions WorkedExampleSession[]

  @@unique([userId, problemId])
}

model ProblemAttempt {
  id                    String     @id @default(cuid())
  userId                String
  problemId             String
  userProblemId         String?
  userAnswer            String     @db.Text
  isCorrect             Boolean    @default(false)
  attemptNumber         Int        @default(1)
  attemptsBeforeCorrect Int        @default(0) @map("attempts_before_correct")
  selfQuizMode          Boolean    @default(false) @map("self_quiz_mode")
  errorType             ErrorType? @map("error_type")
  errorExplanation      String?    @map("error_explanation")
  createdAt             DateTime   @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userProblem UserProblem? @relation(fields: [userProblemId], references: [id], onDelete: SetNull)
  reflections Reflection[]

  @@index([userId, createdAt])
  @@index([problemId, createdAt])
}

model Reflection {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  attemptId String?
  prompt    String   @db.Text
  response  String   @db.Text
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  attempt ProblemAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model WorkedExampleSession {
  id                   String   @id @default(cuid())
  userId               String
  problemId            String
  userProblemId        String?
  studyDurationSeconds Int      @default(0) @map("study_duration_seconds")
  generateAttempt      String?  @map("generate_attempt") @db.Text
  selfAssessedMatch    Boolean? @map("self_assessed_match")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userProblem UserProblem? @relation(fields: [userProblemId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  featureName String   @unique @map("feature_name")
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model LearningAnalytics {
  id         String         @id @default(cuid())
  userId     String
  sessionKey String         @map("session_key")
  method     LearningMethod
  aggregate  Json
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionKey, method])
  @@index([userId, createdAt])
  @@map("learning_analytics")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  problemId String? // nullable - chat can be about a problem or freeform
  title     String?
  createdAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem  Problem?      @relation(fields: [problemId], references: [id])
  messages ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id        String       @id @default(cuid())
  userId    String
  feature   UsageFeature
  bucket    DateTime // UTC start-of-day bucket
  count     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, bucket])
}

model Notebook {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents NotebookDocument[]
  chunks    NotebookChunk[]
  summaries NotebookSummary[]
  concepts  NotebookConcept[]

  @@index([userId, updatedAt])
}

model NotebookDocument {
  id              String                  @id @default(cuid())
  notebookId      String
  userId          String
  title           String
  sourceType      NotebookSourceType
  mimeType        String?
  byteSize        Int?
  rawText         String                  @db.Text
  contentHash     String
  ingestionStatus NotebookIngestionStatus @default(PROCESSED)
  chunkCount      Int                     @default(0)
  charCount       Int                     @default(0)
  storageMetadata Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  notebook Notebook        @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks   NotebookChunk[]

  @@index([notebookId, createdAt])
  @@index([userId, createdAt])
}

model NotebookChunk {
  id          String   @id @default(cuid())
  notebookId  String
  documentId  String
  userId      String
  chunkIndex  Int
  content     String   @db.Text
  contentHash String
  charCount   Int      @default(0)
  createdAt   DateTime @default(now())

  notebook Notebook         @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  document NotebookDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([notebookId, chunkIndex])
  @@index([userId, createdAt])
}

model NotebookSummary {
  id             String   @id @default(cuid())
  notebookId     String
  userId         String
  summary        String   @db.Text
  keyPoints      Json?
  sourceChunkIds Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notebookId, createdAt])
  @@index([userId, createdAt])
}

model NotebookConcept {
  id               String   @id @default(cuid())
  notebookId       String
  userId           String
  name             String
  explanation      String   @db.Text
  evidenceChunkIds Json?
  confidence       Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notebookId, createdAt])
  @@index([userId, createdAt])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ReviewStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum Tier {
  FREE
  PRO
  MAX
}

enum Plan {
  FREE
  PRO
  MAX
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum UsageFeature {
  CHAT_MESSAGE
  NEW_CHAT_SESSION
  PROBLEM_START
}

enum ErrorType {
  CONCEPTUAL_GAP
  ALGEBRAIC_SLIP
  MISREAD_QUESTION
  FORMULA_RECALL_FAILURE
  WRONG_METHOD_CHOSEN
}

enum LearningMethod {
  SPACED_REPETITION
  RETRIEVAL_PRACTICE
  INTERLEAVED_PRACTICE
  ELABORATIVE_INTERROGATION
  WORKED_EXAMPLE_STUDY
  ERROR_ANALYSIS
}

enum NotebookSourceType {
  TEXT
  PDF
}

enum NotebookIngestionStatus {
  PENDING
  PROCESSED
  FAILED
}

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referredUserId String   @unique
  createdAt      DateTime @default(now())
  rewarded       Boolean  @default(false)
}
